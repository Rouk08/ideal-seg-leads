# ---------------------------------------------------------------------------
# Copie este arquivo para ".env" (mesma pasta) antes de subir o docker-compose.
# Para rodar o backend fora do Docker (npm run dev), copie estas mesmas
# variáveis para backend/.env — veja o README.
# ---------------------------------------------------------------------------

# Postgres (usado pelo docker-compose para criar o container e montar a DATABASE_URL)
POSTGRES_USER=idealseg
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=ideal_seg_leads

# Se for rodar o backend FORA do docker-compose (npm run dev em backend/),
# defina a DATABASE_URL apontando pro Postgres do compose (ou um Postgres local):
DATABASE_URL=postgresql://idealseg:troque-esta-senha@localhost:5432/ideal_seg_leads

# Gere valores aleatórios longos, ex.: `openssl rand -base64 48`
JWT_ACCESS_SECRET=troque-por-um-segredo-aleatorio-de-32-caracteres-ou-mais
JWT_REFRESH_SECRET=troque-por-outro-segredo-aleatorio-diferente-do-de-cima

JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=30

# Prazo de validade do link de convite enviado ao vendedor
INVITE_EXPIRES_IN_HOURS=72

# URL pública do frontend — usada para montar o link "https://.../aceitar-convite?token=..."
APP_URL=http://localhost:5173
# Origem permitida no CORS (o frontend em si)
CORS_ORIGIN=http://localhost:5173

# Rate limit do login
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_MIN=15

PORT=3333
NODE_ENV=development

# Só relevante rodando o backend fora do Docker (dentro do container já é /app/uploads)
UPLOADS_DIR=./uploads

# Usado só pelo seed inicial (senha do usuário admin de bootstrap) — troque
# no primeiro login e nunca deixe este valor no .env de produção depois disso.
SEED_ADMIN_SENHA=TrocarSenha123!
