# Copie para backend/.env.test — banco SEPARADO do de desenvolvimento.
# Os testes fazem TRUNCATE nas tabelas a cada teste; nunca aponte isto para
# o mesmo banco que você usa para desenvolver/ver dados de verdade.

DATABASE_URL=postgresql://idealseg:troque-esta-senha@localhost:5432/ideal_seg_leads_test

JWT_ACCESS_SECRET=segredo-de-teste-qualquer-com-32-caracteres-ou-mais
JWT_REFRESH_SECRET=outro-segredo-de-teste-diferente-do-de-cima

JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=30
INVITE_EXPIRES_IN_HOURS=72
APP_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_LOGIN_MAX=1000
RATE_LIMIT_LOGIN_WINDOW_MIN=15
PORT=3334
NODE_ENV=test
